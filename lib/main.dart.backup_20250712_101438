                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          IconButton(
                            onPressed: () {
                              setState(() {
                                if (widget.exercise.weight > 0) widget.exercise.weight -= 5;
                              });
                            },
                            icon: const Icon(Icons.remove),
                          ),
                          Text('${widget.exercise.weight.toInt()} lbs'),
                          IconButton(
                            onPressed: () {
                              setState(() {
                                widget.exercise.weight += 5;
                              });
                            },
                            icon: const Icon(Icons.add),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
              ],
            ),
            if (widget.showLikeButton) ...[
              const SizedBox(height: 16),
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceAround,
                children: [
                  _buildLikeButton(),
                  _buildDislikeButton(),
                ],
              ),
            ],
          ],
        ),
      ),
    );
  }

  Widget _buildLikeButton() {
    final dataManager = FitnessDataManager();
    final currentPreference = dataManager.exercisePreferences[widget.exercise.name] ?? 0;
    
    return ElevatedButton(
      onPressed: () {
        dataManager.likeExercise(widget.exercise.name, widget.exercise.muscles, widget.exercise.sets, widget.exercise.reps, widget.exercise.weight);
        widget.onUpdate();
      },
      child: Text(
        currentPreference > 0 ? 'Liked' : 'Like',
        style: const TextStyle(color: Colors.white),
      ),
    );
  }

  Widget _buildDislikeButton() {
    final dataManager = FitnessDataManager();
    final currentPreference = dataManager.exercisePreferences[widget.exercise.name] ?? 0;
    
    return ElevatedButton(
      onPressed: () {
        dataManager.dislikeExercise(widget.exercise.name);
        widget.onUpdate();
      },
      child: Text(
        currentPreference < 0 ? 'Disliked' : 'Dislike',
        style: const TextStyle(color: Colors.white),
      ),
    );
  }
}


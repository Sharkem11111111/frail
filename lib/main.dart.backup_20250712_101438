String _inferMuscleTargetsFromName(String exerciseName) {
  final name = exerciseName.toLowerCase();
  
  if (name.contains('push') || name.contains('chest')) return 'Chest, Triceps, Shoulders';
  if (name.contains('pull') || name.contains('row')) return 'Back, Biceps';
  if (name.contains('squat')) return 'Legs, Glutes';
  if (name.contains('curl')) return 'Biceps';
  if (name.contains('press') && (name.contains('shoulder') || name.contains('overhead'))) return 'Shoulders, Triceps';
  if (name.contains('press') && name.contains('bench')) return 'Chest, Triceps, Shoulders';
  if (name.contains('dip')) return 'Triceps, Chest';
  if (name.contains('plank') || name.contains('crunch')) return 'Core';
  if (name.contains('lunge')) return 'Legs, Glutes';
  if (name.contains('bridge')) return 'Glutes, Hamstrings';
  if (name.contains('fly')) return 'Chest';
  if (name.contains('raise')) return 'Shoulders';
  
  return 'Full Body'; // Default
}


  void _processAiActions(String aiResponse, String userMessage) {
    final FitnessDataManager dataManager = FitnessDataManager();
    final messageLower = userMessage.toLowerCase();
    final responseLower = aiResponse.toLowerCase();

    // Workout modifications based on pain/injury
    if (messageLower.contains('hurt') || messageLower.contains('pain')) {
      if (messageLower.contains('knee')) {
        // Replace knee-intensive exercises
        dataManager.removeExercise('Squats');
        dataManager.addExercise('Wall Sits', 'Glutes, Quads (knee-friendly)', sets: 3, reps: 30);
        dataManager.replaceExercise('Lunges', 'Glute Bridges', 'Glutes, Hamstrings', sets: 3, reps: 15);
        _aiActions.add('🏋️ Modified workout for knee safety - added Wall Sits & Glute Bridges');
      } else if (messageLower.contains('shoulder')) {
        // Remove overhead/shoulder exercises
        dataManager.removeExercise('Push-ups');
        dataManager.addExercise('Chest Flyes', 'Chest (shoulder-friendly)', sets: 3, reps: 12);
        dataManager.replaceExercise('Pull-ups', 'Seated Rows', 'Back, Biceps', sets: 3, reps: 10);
      } else if (messageLower.contains('back')) {
        // Remove back-intensive exercises
        dataManager.removeExercise('Pull-ups');
        dataManager.removeExercise('Plank');
        dataManager.addExercise('Walking', 'Full body (low impact)', sets: 1, reps: 20); // 20 minutes
        dataManager.addExercise('Gentle Stretching', 'Flexibility', sets: 3, reps: 10);
      }
    }
    
    // Calorie adjustments
    if (messageLower.contains('calorie') || messageLower.contains('diet') || messageLower.contains('eat')) {
      if (messageLower.contains('lose weight') || messageLower.contains('cut')) {
        dataManager.updateCalorieGoal(1800); // Deficit for weight loss
        _aiActions.add('🍽️ Set calorie goal to 1800 for weight loss');
      } else if (messageLower.contains('gain') || messageLower.contains('bulk')) {
        dataManager.updateCalorieGoal(2600); // Surplus for weight gain
        _aiActions.add('🍽️ Set calorie goal to 2600 for muscle gain');
      } else if (messageLower.contains('maintain')) {
        dataManager.updateCalorieGoal(2200); // Maintenance calories
        _aiActions.add('🍽️ Set calorie goal to 2200 for maintenance');
      }
      
      // Add suggested foods mentioned in AI response
      if (responseLower.contains('protein') && responseLower.contains('shake')) {
        dataManager.addFood(FoodEntry('AI Recommended Protein Shake', 300, protein: 25.0, mealType: MealType.snack));
      }
      if (responseLower.contains('chicken') || responseLower.contains('lean protein')) {
        dataManager.addFood(FoodEntry('AI Suggested: Grilled Chicken', 250, protein: 30.0, mealType: MealType.lunch));
      }
    }

    // Sleep adjustments - MORE SENSITIVE DETECTION
    if (messageLower.contains('sleep') || messageLower.contains('tired') || messageLower.contains('rest') || 
        messageLower.contains('slept') || messageLower.contains('hour')) {
      
      // Extract hours from user message first
      RegExp hoursRegex = RegExp(r'(\d+(?:\.\d+)?)\s*hours?');
      Match? match = hoursRegex.firstMatch(messageLower);
      
      if (match != null) {
        double hours = double.tryParse(match.group(1) ?? '') ?? 7.5;
        
        // If user mentions they slept X hours, log it
        if (messageLower.contains('slept') || messageLower.contains('sleep')) {
          dataManager.logSleep(hours);
          _aiActions.add('💤 Updated your sleep log to $hours hours');
          print('AI ACTION: Updated sleep to $hours hours'); // Debug
        }
        
        // Update sleep goal based on what they mention
        if (messageLower.contains('need') || messageLower.contains('should') || messageLower.contains('goal')) {
          dataManager.updateSleepGoal(hours);
          print('AI ACTION: Updated sleep goal to $hours hours'); // Debug
        }
      } else {
        // Handle common sleep adjustments without specific numbers
        if (messageLower.contains('more sleep') || messageLower.contains('need more')) {
          dataManager.updateSleepGoal(8.5);
        } else if (messageLower.contains('less sleep')) {
          dataManager.updateSleepGoal(7.0);
        }
      }
    }

    // Workout modifications from AI recommendations
    if (messageLower.contains('workout') || messageLower.contains('routine') || messageLower.contains('exercise') || 
        messageLower.contains('recommend') || messageLower.contains('suggest')) {
      
      // Parse workout recommendations from AI response
      _parseAndApplyWorkoutFromAI(aiResponse, userMessage);
    }

    // Progressive overload suggestions
    if (messageLower.contains('progress') || messageLower.contains('increase') || messageLower.contains('weight')) {
      // Find and update exercise weights based on AI suggestions
      if (responseLower.contains('bench press') && responseLower.contains('140')) {
        final benchIndex = dataManager.currentWorkout.indexWhere((ex) => ex.name.toLowerCase().contains('push'));
        if (benchIndex != -1) {
          dataManager.currentWorkout[benchIndex].weight = 140;
          dataManager.onWorkoutChanged?.call();
        }
      }
      if (responseLower.contains('squat') && responseLower.contains('195')) {
        dataManager.replaceExercise('Squats', 'Squats (Progressive)', 'Legs, Glutes', sets: 4, reps: 8, weight: 195);
      }
    }
  }


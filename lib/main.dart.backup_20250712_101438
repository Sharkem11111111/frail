  String _formatSessionDate(DateTime date) {
    final now = DateTime.now();
    final difference = now.difference(date);
    
    if (difference.inDays == 0) {
      return 'Today';
    } else if (difference.inDays == 1) {
      return 'Yesterday';
    } else if (difference.inDays < 7) {
      return '${difference.inDays} days ago';
    } else {
      return '${date.month}/${date.day}/${date.year}';
    }
  }

  void _parseAndApplyWorkoutFromAI(String aiResponse, String userMessage) {
    final FitnessDataManager dataManager = FitnessDataManager();
    final responseLower = aiResponse.toLowerCase();
    final messageLower = userMessage.toLowerCase();
    
    // Only apply workout if user specifically asked for one and AI provided exercises
    if (!messageLower.contains('workout') && !messageLower.contains('routine') && !messageLower.contains('recommend')) {
      return;
    }
    
    // Check if AI provided actual exercise recommendations
    List<Map<String, dynamic>> newExercises = [];
    
    // Parse common exercise patterns from AI response
    final exercisePatterns = [
      // Pattern: Exercise: sets × reps
      RegExp(r'(\w+(?:\s+\w+)*?(?:press|curl|squat|pullup|pushup|plank|row|fly|raise|dip|lunge|bridge))\s*:?\s*(\d+)\s*(?:sets?|x)\s*[×x]\s*(\d+)\s*(?:reps?)?', caseSensitive: false),
      // Pattern: Exercise - sets sets of reps reps
      RegExp(r'(\w+(?:\s+\w+)*?(?:press|curl|squat|pullup|pushup|plank|row|fly|raise|dip|lunge|bridge))\s*-?\s*(\d+)\s*sets?\s*of\s*(\d+)\s*reps?', caseSensitive: false),
      // Pattern: sets × reps Exercise
      RegExp(r'(\d+)\s*[×x]\s*(\d+)\s*(\w+(?:\s+\w+)*?(?:press|curl|squat|pullup|pushup|plank|row|fly|raise|dip|lunge|bridge))', caseSensitive: false),
    ];
    
    for (RegExp pattern in exercisePatterns) {
      final matches = pattern.allMatches(aiResponse);
      for (Match match in matches) {
        if (pattern == exercisePatterns[2]) {
          // For the third pattern, order is different
          newExercises.add({
            'name': _cleanExerciseName(match.group(3)!),
            'sets': int.tryParse(match.group(1)!) ?? 3,
            'reps': int.tryParse(match.group(2)!) ?? 10,
          });
        } else {
          newExercises.add({
            'name': _cleanExerciseName(match.group(1)!),
            'sets': int.tryParse(match.group(2)!) ?? 3,
            'reps': int.tryParse(match.group(3)!) ?? 10,
          });
        }
      }
    }
    
    // Apply the new workout if exercises were found
    if (newExercises.isNotEmpty) {
      // Clear current workout and add new exercises
      dataManager.currentWorkout.clear();
      
      for (Map<String, dynamic> exerciseData in newExercises) {
        String exerciseName = exerciseData['name'];
        String muscleTargets = _inferMuscleTargets(exerciseName);
        
        // Check if muscles are available (not overworked)
        List<String> targetedMuscles = dataManager.extractMusclesFromExercise(exerciseName, muscleTargets);
        List<String> availableMuscles = dataManager.getAvailableMuscles();
        
        // Only add exercise if at least one target muscle is available
        bool canPerform = targetedMuscles.any((muscle) => availableMuscles.contains(muscle));
        
        if (canPerform || targetedMuscles.isEmpty) {
          // Get recommended weight based on user's history
          double recommendedWeight = dataManager.getRecommendedWeight(exerciseName, 0.0);
          
          dataManager.addExercise(
            exerciseName,
            muscleTargets,
            sets: exerciseData['sets'],
            reps: exerciseData['reps'],
            weight: recommendedWeight,
          );
        }
      }
      
      _aiActions.add('🏋️ Updated your workout with ${newExercises.length} AI-recommended exercises');
      dataManager.onWorkoutChanged?.call();
    }
  }

  String _cleanExerciseName(String name) {
    // Clean up the exercise name
    return name.trim()
        .split(' ')
        .map((word) => word.toLowerCase().replaceAll(RegExp(r'[^\w]'), ''))
        .where((word) => word.isNotEmpty)
        .map((word) => word[0].toUpperCase() + word.substring(1))
        .join(' ');
  }

  String _inferMuscleTargets(String exerciseName) {
    final name = exerciseName.toLowerCase();
    
    if (name.contains('push') || name.contains('chest')) return 'Chest, Triceps, Shoulders';
    if (name.contains('pull') || name.contains('row')) return 'Back, Biceps';
    if (name.contains('squat')) return 'Legs, Glutes';
    if (name.contains('curl')) return 'Biceps';
    if (name.contains('press') && (name.contains('shoulder') || name.contains('overhead'))) return 'Shoulders, Triceps';
    if (name.contains('press') && name.contains('bench')) return 'Chest, Triceps, Shoulders';
    if (name.contains('dip')) return 'Triceps, Chest';
    if (name.contains('plank') || name.contains('crunch')) return 'Core';
    if (name.contains('lunge')) return 'Legs, Glutes';
    if (name.contains('bridge')) return 'Glutes, Hamstrings';
    if (name.contains('fly')) return 'Chest';
    if (name.contains('raise')) return 'Shoulders';
    
    return 'Full Body'; // Default
  }


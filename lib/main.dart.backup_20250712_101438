// Workout Session for tracking progress
class WorkoutSession {
  final String exerciseName;
  final double weight;
  final int sets;
  final int reps;
  final int completedSets;
  final int completedReps;
  final bool wasTooHeavy;
  final DateTime date;
  final int totalTime; // in seconds

  WorkoutSession({
    required this.exerciseName,
    required this.weight,
    required this.sets,
    required this.reps,
    required this.completedSets,
    required this.completedReps,
    required this.wasTooHeavy,
    required this.date,
    required this.totalTime,
  });

  Map<String, dynamic> toJson() {
    return {
      'exerciseName': exerciseName,
      'weight': weight,
      'sets': sets,
      'reps': reps,
      'completedSets': completedSets,
      'completedReps': completedReps,
      'wasTooHeavy': wasTooHeavy,
      'date': date.toIso8601String(),
      'totalTime': totalTime,
    };
  }

  factory WorkoutSession.fromJson(Map<String, dynamic> json) {
    return WorkoutSession(
      exerciseName: json['exerciseName'] ?? '',
      weight: (json['weight'] ?? 0).toDouble(),
      sets: json['sets'] ?? 0,
      reps: json['reps'] ?? 0,
      completedSets: json['completedSets'] ?? 0,
      completedReps: json['completedReps'] ?? 0,
      wasTooHeavy: json['wasTooHeavy'] ?? false,
      date: DateTime.parse(json['date'] ?? DateTime.now().toIso8601String()),
      totalTime: json['totalTime'] ?? 0,
    );
  }
}


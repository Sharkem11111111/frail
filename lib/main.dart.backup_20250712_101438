class SavedWorkout {
  String id;
  String name;
  List<Exercise> exercises;
  DateTime createdDate;
  String description;

  SavedWorkout({
    required this.id,
    required this.name,
    required this.exercises,
    required this.createdDate,
    this.description = '',
  });

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'name': name,
      'exercises': exercises.map((e) => {
        'name': e.name,
        'muscles': e.muscles,
        'sets': e.sets,
        'reps': e.reps,
        'weight': e.weight,
      }).toList(),
      'createdDate': createdDate.toIso8601String(),
      'description': description,
    };
  }

  factory SavedWorkout.fromJson(Map<String, dynamic> json) {
    return SavedWorkout(
      id: json['id'] ?? '',
      name: json['name'] ?? '',
      exercises: (json['exercises'] as List?)?.map((e) {
        final exercise = Exercise(e['name'] ?? '', e['muscles'] ?? '');
        exercise.sets = e['sets'] ?? 0;
        exercise.reps = e['reps'] ?? 0;
        exercise.weight = (e['weight'] ?? 0).toDouble();
        return exercise;
      }).toList() ?? [],
      createdDate: DateTime.parse(json['createdDate']),
      description: json['description'] ?? '',
    );
  }
}


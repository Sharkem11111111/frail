// Equipment Management Classes
class EquipmentItem {
  final String name;
  bool isAvailable;
  double? maxWeight;
  List<double> availableWeights; // For specific weight pairs/plates

  EquipmentItem(this.name, this.isAvailable, {this.maxWeight, List<double>? availableWeights}) 
    : availableWeights = availableWeights ?? [];

  // Check if equipment supports multiple specific weights
  bool get supportsMultipleWeights {
    return name.toLowerCase().contains('dumbbell') || 
           name.toLowerCase().contains('kettlebell') ||
           name.toLowerCase().contains('medicine ball');
  }

  String getWeightDescription() {
    if (availableWeights.isEmpty) {
      return maxWeight != null ? 'Up to ${maxWeight!.toInt()} lbs' : 'Bodyweight';
    } else {
      availableWeights.sort();
      return 'Available: ${availableWeights.map((w) => '${w.toInt()} lbs').join(', ')}';
    }
  }
}


                    end: Alignment.bottomCenter,
                    colors: [
                      Colors.orange.withOpacity(0.8),
                      Colors.orange.withOpacity(0.4),
                    ],
                  ),
                ),
                child: selectedGame == 'none' 
                  ? _buildGameSelection(timeRemaining)
                    : selectedGame == 'chess'
